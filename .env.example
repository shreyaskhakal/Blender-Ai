# ==============================================================================
# Blender AI — Environment Variable Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the required values for your environment.
# WARNING: NEVER commit '.env' or any file containing real API keys or secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS (Backend Only)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://blender_user:blender_dev_password@localhost:5432/blender_ai?schema=public

# ------------------------------------------------------------------------------
# 3. TASK QUEUE & CACHE (Redis 7+)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (S3 Compatible: MinIO in Dev, AWS S3 / Cloudflare R2 in Prod)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blender-ai-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY SECRETS (Backend Only)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long
SESSION_MAX_AGE_SECONDS=604800

# ------------------------------------------------------------------------------
# 6. TRIPO3D AI PROVIDER CONFIGURATION (Backend Only — NEVER expose to browser)
# ------------------------------------------------------------------------------
# Obtain an API key from: https://platform.tripo3d.ai/api-keys
TRIPOSR_API_KEY=your_tripo3d_api_key_here

# When set to 'true', requests use local mock fixtures without consuming credits.
# Strictly required to be 'true' for CI and automated unit testing.
TRIPO3D_USE_MOCK=true

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (Vite — Browser Exposed via 'VITE_' prefix)
# ------------------------------------------------------------------------------
# Only variables prefixed with VITE_ are injected into the client JavaScript bundle.
# NEVER put private secrets or TRIPOSR_API_KEY into VITE_ variables!
VITE_API_URL=http://localhost:4000/api/v1
